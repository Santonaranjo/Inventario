# Copia este archivo como .env:  Copy-Item .env.example .env
# Con Docker, DATABASE_URL y TEST_DATABASE_URL los reemplaza docker-compose.yml (host "db").

APP_ENV=development

# --- Base de datos (sin Docker o con la opción C del README) ---
DATABASE_URL=postgresql+psycopg://inventario:inventario@localhost:5432/inventario
TEST_DATABASE_URL=postgresql+psycopg://inventario:inventario@localhost:5432/inventario_test

# --- JWT ---
# Cámbiala: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- CORS: orígenes del frontend separados por coma ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Negocio ---
IVA_PORCENTAJE=19.00

# --- Admin que crea el seed (python -m app.seed) ---
ADMIN_EMAIL=admin@inventario.com
ADMIN_PASSWORD=Admin123*
ADMIN_NOMBRE=Administrador

# --- Solo docker-compose (puertos en Windows) ---
# Si el 5432 ya lo usa otro PostgreSQL, pon otro libre (p. ej. 5435) y usa ese puerto en DATABASE_URL.
DB_PORT=5432
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
